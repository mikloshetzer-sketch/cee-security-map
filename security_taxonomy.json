      "terrorism": "high",
      "public_order": "low",
      "transport": "medium",
      "natural_hazard": "medium",
      "intelligence": "medium"
    },
    "upgrade_rules": [
      {
        "when_consequence": "fatality",
        "minimum": "critical"
      },
      {
        "when_consequence": "major_damage",
        "minimum": "high"
      },
      {
        "when_consequence": "contamination",
        "minimum": "critical"
      },
      {
        "when_target": "civilian",
        "and_action_any": [
          "attacked",
          "exploded",
          "impact"
        ],
        "minimum": "high"
      },
      {
        "when_target": "energy",
        "and_action_any": [
          "attacked",
          "exploded",
          "burned",
          "damaged"
        ],
        "minimum": "high"
      },
      {
        "when_target": "government",
        "and_action_any": [
          "attacked",
          "exploded"
        ],
        "minimum": "high"
      },
      {
        "when_multiple_sources_at_least": 3,
        "confidence_only": true
      }
    ],
    "downgrade_rules": [
      {
        "when_article_role": [
          "reaction",
          "analysis",
          "summary",
          "historical"
        ],
        "to": "info"
      },
      {
        "when_action": "detected",
        "and_no_consequence": true,
        "maximum": "low"
      }
    ]
  },
  "confidence_model": {
    "base": 0.2,
    "weights": {
      "object_match": 0.2,
      "action_match": 0.2,
      "target_match": 0.08,
      "actor_match": 0.06,
      "country_match": 0.1,
      "city_match": 0.08,
      "consequence_match": 0.08,
      "official_source_signal": 0.08,
      "multiple_source_signal": 0.06,
      "supporting_evidence": 0.06
    },
    "penalties": {
      "country_fallback": 0.08,
      "negative_context": 0.45,
      "article_role_non_incident": 0.35,
      "ambiguous_country": 0.25,
      "missing_action": 0.2,
      "missing_object": 0.2
    },
    "caps": {
      "maximum": 0.99,
      "minimum": 0.0
    }
  },
