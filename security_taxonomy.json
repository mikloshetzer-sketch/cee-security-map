  "severity_model": {
    "levels": [
      "info",
      "low",
      "medium",
      "high",
      "critical"
    ],
    "base_by_family": {
      "air": "medium",
      "ground": "medium",
      "maritime": "medium",
      "cyber": "medium",
      "energy": "medium",
      "critical_infrastructure": "medium",
      "industrial": "medium",
