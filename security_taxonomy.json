{
  "metadata": {
    "name": "CEE Security Knowledge Base",
    "version": "1.0.0",
    "schema_version": "1.0",
    "language": "multilingual",
    "description": "Machine-readable taxonomy and rule base for classifying security incidents in Central and Eastern Europe.",
    "supported_languages": [
      "en",
      "hu",
      "ro",
      "pl",
      "sk",
      "cs",
      "lt",
      "lv",
      "et"
    ],
    "design_principle": "Incidents are composed from object + action + context + evidence instead of one standalone rule per event type."
  },
  "runtime": {
    "normalization": {
      "lowercase": true,
      "unicode_normalization": "NFKC",
      "collapse_whitespace": true,
      "strip_html": true,
      "whole_term_matching": true
    },
    "classification": {
      "allow_multiple_candidates": true,
      "select_highest_confidence": true,
      "minimum_acceptance_confidence": 0.68,
      "minimum_incident_confidence": 0.72,
      "minimum_followup_confidence": 0.62,
      "default_actual_incident": false
    }
  },
  "families": {
    "air": {
      "label": "Air security",
      "default_severity": "medium",
